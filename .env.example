DATABASE_URL=postgresql://grocery:yourpassword@db:5432/grocery
JWT_SECRET=change-me-to-a-long-random-string
POSTGRES_USER=grocery
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=grocery

# OpenRouter (used for item categorization embeddings)
OPENROUTER_API_KEY=
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# HTTP(S) proxy for reaching openrouter.ai when it's not directly reachable
# from the production network. Falls back to HTTPS_PROXY/https_proxy if unset.
# OPENROUTER_PROXY_URL=http://user:pass@proxy-host:port
