DATABASE_URL=postgresql://grocery:yourpassword@db:5432/grocery
JWT_SECRET=change-me-to-a-long-random-string
POSTGRES_USER=grocery
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=grocery

# OpenRouter (used for item categorization embeddings)
OPENROUTER_API_KEY=
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# HTTP(S) proxy for reaching openrouter.ai when it's not directly reachable
# from the production network. Falls back to HTTPS_PROXY/https_proxy if unset.
# OPENROUTER_PROXY_URL=http://user:pass@proxy-host:port

# SSO via OpenID Connect (e.g. Authentik). Enabled when ISSUER, CLIENT_ID and
# CLIENT_SECRET are all set. Redirect URI to register at the provider:
#   ${APP_URL}/api/auth/oidc/callback
# APP_URL=https://grocery.example.com
# OIDC_ISSUER=https://auth.example.com/application/o/grocery/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Authentik
# OIDC_SCOPES=openid email profile
# Treat provider emails as verified even if email_verified is not true
# (allows linking existing password accounts by email).
# OIDC_TRUST_EMAIL=false
